NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://chatbot:chatbot_dev@localhost:5432/chatbot?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_another_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com

# OAuth (Sign in with Apple, Google Sign-In).
# OAUTH_MODE=mock makes the backend accept "mock.<base64-json>" tokens — used
# by CI / no-credentials dev only. Leave blank to use real Apple/Google JWKS.
OAUTH_MODE=
# Comma-separated allowlist (your iOS bundle ID + Service ID for web).
APPLE_AUDIENCES=
# Comma-separated OAuth client IDs (one per platform iOS/Android/Web).
GOOGLE_CLIENT_IDS=

# In-App Purchases (Apple App Store Server API v2 + Google Play Developer API).
# IAP_MODE=mock makes the backend accept "mock:<product>:<txn>" receipts —
# used by CI / no-credentials dev only. Leave blank to use real verifiers.
IAP_MODE=
# Comma-separated bundle ids accepted by the Apple verifier.
APPLE_IAP_BUNDLE_IDS=
# Your Android package name (e.g. com.example.chatbot).
GOOGLE_PLAY_PACKAGE_NAME=
# Base64-encoded service-account JSON key with androidpublisher scope.
GOOGLE_PLAY_SERVICE_KEY_B64=

# Push (Firebase Cloud Messaging — iOS via APNs is routed by Firebase).
# PUSH_MODE=mock records sends in memory + exposes GET /admin/push/log for
# tests. Leave blank in production to use the real FCM provider.
PUSH_MODE=
FCM_PROJECT_ID=
# Base64-encoded service-account JSON with firebase.messaging scope.
FCM_SERVICE_KEY_B64=
